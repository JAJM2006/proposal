---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { FaTwitch, FaInstagram, FaYoutube, FaExternalLinkAlt } from "react-icons/fa";

const linksCollection = await getCollection("links");
const pageData = linksCollection[0]?.data;

if (!pageData) {
  throw new Error("Missing content in src/content/links/-index.md");
}

const getPlatformIcon = (name: string) => {
  switch (name.toLowerCase()) {
    case "twitch":
      return FaTwitch;
    case "instagram":
      return FaInstagram;
    case "youtube":
      return FaYoutube;
    default:
      return FaExternalLinkAlt;
  }
};
---

<BaseLayout title={pageData.title} description={pageData.description}>
  <section class="container py-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h1 class="text-4xl font-bold mb-3">{pageData.title}</h1>
      <p class="text-txt-p/80 dark:text-darkmode-txt-p/80">{pageData.description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pageData.platforms?.map((platform) => {
        const Icon = getPlatformIcon(platform.name);
        return (
          <div class="glass p-6 rounded-lg flex flex-col justify-between hover:border-primary/50 transition">
            <div>
              <div class="flex items-center space-x-3 mb-4">
                <div class="p-3 glass-t rounded-lg text-2xl text-txt-p dark:text-darkmode-txt-p">
                  <Icon />
                </div>
                <div>
                  <span class="text-xs uppercase tracking-wider font-semibold opacity-70">
                    {platform.name}
                  </span>
                  <h2 class="text-xl font-bold leading-tight">{platform.title}</h2>
                </div>
              </div>

              <p class="text-sm text-txt-p/80 dark:text-darkmode-txt-p/80 mb-4">
                {platform.description}
              </p>

              {platform.highlights && (
                <ul class="space-y-2 mb-6 text-sm list-disc list-inside opacity-90">
                  {platform.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>

            <a
              href={platform.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center space-x-2 w-full py-2.5 px-4 rounded-lg glass-t font-semibold hover:opacity-80 transition text-center"
            >
              <span>Visit {platform.name}</span>
              <FaExternalLinkAlt className="w-3.5 h-3.5" />
            </a>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
