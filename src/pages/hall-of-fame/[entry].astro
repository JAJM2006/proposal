---
import type { Hall-of-fameEntry, vaultEntry } from "@/types";
import EntryLayout from "@components/hall-of-fame/EntryLayout.astro";
import { slugify } from "@lib/textConverter";
import { getEntries } from "@lib/contentParser";
import { sortByDate } from "@lib/sortFunctions";

export async function getStaticPaths() {
  const entries = (await getEntries("hall-of-fame")) as Hall-of-fameEntry[];
  const paths = entries.map((entry) => ({
    params: {
      entry: entry.id,
    },
    props: { entry },
  }));
  return paths;
}

const { entry } = Astro.props;
const { title } = entry.data;
const vaultEntries = (await getEntries("vault", sortByDate)) as vaultEntry[];
const filteredvaultEntries = vaultEntries.filter(
  (entry: vaultEntry) =>
    slugify(entry.data.author?.id ? entry.data.author.id : "Jane Doe") ===
    slugify(title)
);
---

<EntryLayout entry={entry} recentvaultEntries={filteredvaultEntries} />