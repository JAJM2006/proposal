---
import CollectionLayout from "@components/hall-of-fame/CollectionLayout.astro";
import { getIndex, getEntries } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

const collectionIndex = await getIndex("hall-of-fame");
const entries = await getEntries("hall-of-fame", sortByTitle);
---

<CollectionLayout entries={entries} collectionIndex={collectionIndex} />
