---
import type { Hall-of-fameEntry } from "@/types";
import CollectionLayout from "@components/hall-of-fame/CollectionLayout.astro";
import { getEntries } from "@lib/contentParser";
import { getIndex } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

const authorIndex = await getIndex("hall-of-fame") as Hall-of-fameEntry;
const entries = await getEntries("hall-of-fame", sortByTitle) as Hall-of-fameEntry[];
---

<CollectionLayout authorIndex={authorIndex} entries={entries} />
