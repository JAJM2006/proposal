---
import type { HallofFameEntry } from "@/types";
import CollectionLayout from "@components/halloffame/CollectionLayout.astro";
import { getEntries } from "@lib/contentParser";
import { getIndex } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

const authorIndex = await getIndex("halloffame") as HallofFameEntry;
const entries = await getEntries("halloffame", sortByTitle) as HallofFameEntry[];
---

<CollectionLayout authorIndex={authorIndex} entries={entries} />
