---
import CollectionLayout from "@components/hall-of-fame/CollectionLayout.astro";
import { getIndex, getGroups } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";

const collectionIndex = await getIndex("hallOfFame");
const groupIndices = await getGroups("hallOfFame", sortByTitle);
---

<CollectionLayout entries={groupIndices} collectionIndex={collectionIndex} />