---
import { Image } from "astro:assets";
import BaseLayout from "@components/base/BaseLayout.astro";
import Social from "@components/common/Social.astro";
import Card from "@components/vault/Card.astro";
import { markdownify } from "@lib/textConverter";

const { entry, recentvaultEntries } = Astro.props;
const { title, role, image, imageAlt, social, description } = entry.data;
---

<BaseLayout title={title} description={description || entry.body}>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 md:col-8 text-center">
          {
            image && (
              <Image
                src={image}
                alt={imageAlt || title}
                width={200}
                height={200}
                class="rounded-full mx-auto mb-6 object-cover w-48 h-48"
              />
            )
          }
          <h1 class="h2 mb-2">{title}</h1>
          {
            role && (
              <span class="inline-block bg-theme-light dark:bg-darkmode-theme-light text-primary px-4 py-1.5 rounded-full text-base font-semibold mb-6">
                {role}
              </span>
            )
          }

          {social && (
            <Social source={social} className="social-icons flex justify-center space-x-4 mb-8" />
          )}

          {
            entry.body && (
              <div
                class="content text-left glass p-8 rounded-lg border border-border dark:border-darkmode-border mb-12 dark:prose-invert"
                set:html={markdownify(entry.body)}
              />
            )
          }
        </div>
      </div>

      {
        recentvaultEntries && recentvaultEntries.length > 0 && (
          <div class="mt-12">
            <h2 class="h3 mb-6 text-center">Contributions by {title}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {recentvaultEntries.map((vaultItem: any) => (
                <Card content={vaultItem} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
